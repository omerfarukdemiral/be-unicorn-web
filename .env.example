# Upstash Redis (Vercel Marketplace → Storage → Upstash for Redis). Either pair works; Vercel sets KV_* for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: extra secret mixed into every PIN hash. Set once, never change (old PINs would stop matching).
PIN_PEPPER=

# Optional: extra hosts allowed to call the API besides the site's own (comma list), e.g. a custom domain alias.
ALLOWED_ORIGINS=

# Client: force offline mode (local save only, no leaderboard).
# VITE_OFFLINE=1
